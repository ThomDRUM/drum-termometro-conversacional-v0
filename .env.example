# ============================================================
# DRUM — Variáveis de ambiente (exemplo)
# Copie pra .env.local e preencha
# ============================================================

# ---------- Anthropic (diagnóstico) ----------
# Pegue em https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# ---------- ElevenLabs (agente de voz) ----------
# Pegue em https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Crie um agente em https://elevenlabs.io/app/agents
# Importante: idioma pt-br + modelo eleven_turbo_v2_5 ou eleven_flash_v2_5
ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ---------- Supabase (banco) ----------
# URL e service_role key do seu projeto em https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# UUID do assessment_template (criado pelo seed após aplicar o schema)
TERMOMETRO_TEMPLATE_ID=

# ---------- App ----------
APP_URL=http://localhost:3000
NODE_ENV=development

# ---------- Admin ----------
# Senha do painel /admin (qualquer string)
DRUM_ADMIN_PASSWORD=
